<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Weekly scheduled flow that identifies stale deals and creates follow-up tasks</description>
    <interviewLabel>Deal Health Weekly Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Deal Health Weekly Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Stale_Deals</targetReference>
        </connector>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2026-03-30</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <formulas>
        <name>SevenDaysAgo</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 7</expression>
    </formulas>
    <recordLookups>
        <name>Get_Stale_Deals</name>
        <label>Get Stale Deals</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Loop_Stale_Deals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Deal_Stage__c</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Closed Won</stringValue></value>
        </filters>
        <filters>
            <field>Deal_Stage__c</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Closed Lost</stringValue></value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value><elementReference>SevenDaysAgo</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Deal__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <loops>
        <name>Loop_Stale_Deals</name>
        <label>Loop Stale Deals</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <collectionReference>Get_Stale_Deals</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_Stale_Deal_Task</targetReference>
        </nextValueConnector>
    </loops>
    <recordCreates>
        <name>Create_Stale_Deal_Task</name>
        <label>Create Stale Deal Task</label>
        <locationX>308</locationX>
        <locationY>398</locationY>
        <connector>
            <targetReference>Loop_Stale_Deals</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value><stringValue>Stale Deal Review - {!Loop_Stale_Deals.Name}</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value><elementReference>$Flow.CurrentDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>Loop_Stale_Deals.OwnerId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value><elementReference>Loop_Stale_Deals.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value><stringValue>High</stringValue></value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
</Flow>
