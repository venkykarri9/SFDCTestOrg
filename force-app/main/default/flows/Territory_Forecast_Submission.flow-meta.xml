<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <description>Screen flow for submitting territory sales forecasts</description>
    <interviewLabel>Territory Forecast Submission {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Territory Forecast Submission</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Territory_Selection_Screen</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>varTerritoryId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varForecastMonth</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTargetAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varCommittedAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varBestCaseAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varNotes</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varExistingForecastId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <screens>
        <name>Territory_Selection_Screen</name>
        <label>Select Territory and Month</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Check_Existing_Forecast</targetReference>
        </connector>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>Territory_Lookup</name>
            <extensionName>flowruntime:lookup</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>fieldApiName</name>
                <value><stringValue>Sales_Territory__c</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value><stringValue>Sales Territory</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>objectApiName</name>
                <value><stringValue>Sales_Territory__c</stringValue></value>
            </inputParameters>
            <inputParameters>
                <name>required</name>
                <value><booleanValue>true</booleanValue></value>
            </inputParameters>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varTerritoryId</assignToReference>
                <name>recordId</name>
            </outputParameters>
        </fields>
        <fields>
            <name>Forecast_Month_Input</name>
            <dataType>Date</dataType>
            <fieldText>Forecast Month (first day of month)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varForecastMonth</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
    </screens>
    <recordLookups>
        <name>Check_Existing_Forecast</name>
        <label>Check Existing Forecast</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <connector>
            <targetReference>Amount_Entry_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Territory__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>varTerritoryId</elementReference></value>
        </filters>
        <filters>
            <field>Forecast_Month__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>varForecastMonth</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sales_Forecast__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <outputAssignments>
            <assignToReference>varExistingForecastId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <screens>
        <name>Amount_Entry_Screen</name>
        <label>Enter Forecast Amounts</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_Create_Or_Update</targetReference>
        </connector>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>Target_Amount_Input</name>
            <dataType>Currency</dataType>
            <fieldText>Target Amount</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <outputParameters>
                <assignToReference>varTargetAmount</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>Committed_Amount_Input</name>
            <dataType>Currency</dataType>
            <fieldText>Committed Amount</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <outputParameters>
                <assignToReference>varCommittedAmount</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>Best_Case_Amount_Input</name>
            <dataType>Currency</dataType>
            <fieldText>Best Case Amount</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <outputParameters>
                <assignToReference>varBestCaseAmount</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>Notes_Input</name>
            <fieldText>Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varNotes</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
    </screens>
    <decisions>
        <name>Decision_Create_Or_Update</name>
        <label>Create or Update Forecast?</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Create_New_Forecast</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Existing Forecast</defaultConnectorLabel>
        <rules>
            <name>Has_Existing_Forecast</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingForecastId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Forecast</targetReference>
            </connector>
            <label>Existing Forecast Found</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_New_Forecast</name>
        <label>Create New Forecast</label>
        <locationX>308</locationX>
        <locationY>638</locationY>
        <connector>
            <targetReference>Submission_Success_Screen</targetReference>
        </connector>
        <inputAssignments>
            <field>Territory__c</field>
            <value><elementReference>varTerritoryId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Forecast_Month__c</field>
            <value><elementReference>varForecastMonth</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Target_Amount__c</field>
            <value><elementReference>varTargetAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Committed_Amount__c</field>
            <value><elementReference>varCommittedAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Best_Case_Amount__c</field>
            <value><elementReference>varBestCaseAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value><elementReference>varNotes</elementReference></value>
        </inputAssignments>
        <object>Sales_Forecast__c</object>
    </recordCreates>
    <recordUpdates>
        <name>Update_Existing_Forecast</name>
        <label>Update Existing Forecast</label>
        <locationX>50</locationX>
        <locationY>638</locationY>
        <connector>
            <targetReference>Submission_Success_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>varExistingForecastId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Target_Amount__c</field>
            <value><elementReference>varTargetAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Committed_Amount__c</field>
            <value><elementReference>varCommittedAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Best_Case_Amount__c</field>
            <value><elementReference>varBestCaseAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value><elementReference>varNotes</elementReference></value>
        </inputAssignments>
        <object>Sales_Forecast__c</object>
    </recordUpdates>
    <screens>
        <name>Submission_Success_Screen</name>
        <label>Forecast Submitted</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>Submission_Success_Message</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Forecast has been successfully submitted.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Your territory forecast has been saved. You can close this window or click Finish to return.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
    </screens>
</Flow>
