<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Thread_Depth__c</fullName>
    <description>Formula that counts how many levels deep this Case sits in the ParentId hierarchy, up to a maximum of 5. Returns 0 when the Case has no parent.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Parent.Id), 0,
  IF(ISBLANK(Parent.Parent.Id), 1,
    IF(ISBLANK(Parent.Parent.Parent.Id), 2,
      IF(ISBLANK(Parent.Parent.Parent.Parent.Id), 3,
        IF(ISBLANK(Parent.Parent.Parent.Parent.Parent.Id), 4,
          5
        )
      )
    )
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Hierarchy depth of this Case based on the ParentId chain. Maximum reported depth is 5.</inlineHelpText>
    <label>Thread Depth</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
