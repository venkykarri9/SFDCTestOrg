<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deal_Value_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Deal_Value__c)), Deal_Value__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Deal_Value__c</errorDisplayField>
    <errorMessage>Deal Value must be greater than zero</errorMessage>
</ValidationRule>
