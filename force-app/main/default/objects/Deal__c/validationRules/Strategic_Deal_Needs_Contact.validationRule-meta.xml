<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Strategic_Deal_Needs_Contact</fullName>
    <active>true</active>
    <description>Strategic deals must have a Primary Contact</description>
    <errorConditionFormula>AND(
    Is_Strategic__c = true,
    ISBLANK(Primary_Contact__c)
)</errorConditionFormula>
    <errorDisplayField>Primary_Contact__c</errorDisplayField>
    <errorMessage>Strategic deals must have a Primary Contact</errorMessage>
</ValidationRule>
