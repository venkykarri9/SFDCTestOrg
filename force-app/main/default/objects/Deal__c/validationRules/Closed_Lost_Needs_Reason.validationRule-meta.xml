<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Lost_Needs_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Deal_Stage__c,&quot;Closed Lost&quot;), ISBLANK(Next_Step__c))</errorConditionFormula>
    <errorDisplayField>Next_Step__c</errorDisplayField>
    <errorMessage>Please provide a reason for losing in the Next Step field</errorMessage>
</ValidationRule>
